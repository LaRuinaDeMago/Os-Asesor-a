.claude/settings.local.json

# Carpetas de expedientes/datos reales si algún día vuelven a aparecer sueltas.
02_EXPEDIENTES/
04_CLIENTE/

# Salidas de medicion: se generan al ejecutar, no se versionan. El agregado se
# sube A MANO cuando trae un numero real que interesa guardar; lo que no puede
# pasar es que se cuele el de un ensayo sintetico y se lea como si fuera real.
retro_semaforo_agregado.json
validacion_captura_agregado.json

# Salida del agregador de IVA por trimestre (mismo criterio que las demas)
reconstruccion_303_agregado.json
cola_revision_agregado.json
# Salida del cruce contabilidad <-> 303 presentados (26-08-2026). Son solo
# recuentos y se puede compartir, pero es el resultado de UNA ejecucion contra
# el archivo real: no describe el codigo, describe una medicion concreta. Mismo
# criterio que los demas agregados.
cruce_303_agregado.json

# Documento de trabajo que vive SOLO en local: contiene apellidos reales
# (asi lo declara SUBE_A_GITHUB.md). Se cita como autoridad en CLAUDE.md y en
# .claude/rules/datos.md, pero nunca sube. Anadido el 10-09-2026 tras
# comprobar con fichero trampa que ni el escaner ni .gitignore lo paraban.
FLUJO_CONTINUO_PLAN_DEFINITIVO.md

# Muestras de crear_muestras_sinteticas.py (16-09-2026). Mismo criterio exacto
# que factura_sintetica_*: el GENERADOR sube (no lleva ningún literal con forma
# de NIF, los compone al ejecutarse llamando a nif_sintetico), su SALIDA no.
# Las imágenes llevan un NIF con checksum válido dibujado encima, y el escáner
# de privacidad —correctamente— no puede distinguir un NIF sintético de uno
# real; menos aún dentro de un PNG, donde ni siquiera es texto. Se regeneran
# con un comando, así que no hay nada que conservar.
muestras_sinteticas/
